NEXUS_NODE_ID=NO-0
NEXUS_ROLE=LEADER
NEXUS_BIND_HOST=127.0.0.1
NEXUS_BIND_PORT=8080
NEXUS_HUB_URL=http://127.0.0.1:8500
NEXUS_SECRET_KEY=change-me-for-local-testing
NEXUS_DB_PATH=./data/nexus.db
NEXUS_EVIDENCE_DIR=./evidence

# Cluster mode (W08-B). There is no default and this example does not set
# one: left as is, the node starts "unconfigured" and refuses local writes,
# peer sync and leadership promotion.
#   single      -> operator asserts this is the ONLY node. Local writes are
#                  allowed; peer sync stays disabled. The runtime cannot prove
#                  that no other node exists (hidden or partitioned nodes are
#                  not detected); never use it on more than one node.
#   distributed -> requires NEXUS_CLUSTER_SIZE >= 2; writes and sync stay
#                  blocked until a quorum-commit protocol exists.
# Invalid values make the node refuse to start.
# See docs/NEXUS_V2700_W08B_CLUSTER_MODE_MIGRATION.md before choosing.
# NEXUS_CLUSTER_MODE=single
# NEXUS_CLUSTER_MODE=distributed
# NEXUS_CLUSTER_SIZE=3
